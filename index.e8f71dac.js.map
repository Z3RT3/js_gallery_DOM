"use strict";
var mainImg = document.querySelector("#largeImg");
var pickImg = document.querySelector(".gallery");
pickImg.addEventListener("click", function(imgChange) {
    imgChange.preventDefault();
    var link = imgChange.target.closest("a", "img");
    if (!link) return;
    mainImg.src = link.href;
});

